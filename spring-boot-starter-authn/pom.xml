<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-platform-parent</artifactId>
        <version>0.2-SNAPSHOT</version>
    </parent>

    <artifactId>casehub-spring-boot-starter-authn</artifactId>
    <packaging>pom</packaging>
    <name>CaseHub Spring Boot Starter :: Authn</name>
    <description>Authentication starter — adds authn-spring (WebAuthn, social OAuth,
        session management) and Spring Data JPA persistence for all authn stores.
        Depends on core starter transitively.</description>

    <dependencies>
        <!-- Core starter (transitively) -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-spring-boot-starter</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>

        <!-- Authn auto-configuration -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-authn-spring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Data JPA persistence -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-session-spring-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-authn-webauthn-spring-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-authn-social-spring-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
