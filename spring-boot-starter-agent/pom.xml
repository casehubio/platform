    <dependencies>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-spring-boot-starter</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-agent-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
